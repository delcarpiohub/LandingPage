# Copiar a .env.local (nunca commitear el archivo real, ver .gitignore).

# --- Resend (envío de correos de contacto) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado. Mientras @delcarpio.cl no esté verificado en Resend,
# usar el dominio de prueba: "Sitio Web Del Carpio <onboarding@resend.dev>"
# (los correos se entregan a RESEND_TEST_RECIPIENT en src/app/api/contacto/route.ts
# y whatsapp-fallback/route.ts en vez del destinatario real, ver comentarios ahí).
RESEND_FROM_EMAIL=

# --- Cloudflare Turnstile (protección anti-bots en los formularios de contacto) ---
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile — crear un
# sitio para delcarpio.cl (gratis). Ver src/lib/turnstile.ts.
# Mientras no exista una cuenta real, usar las keys de prueba de Cloudflare
# (siempre aprueban, sin necesidad de cuenta):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (rate limiting distribuido, opcional) ---
# Sin configurar, los endpoints de contacto usan un rate limit en memoria por
# instancia (funciona, pero no coordina entre instancias serverless). Para
# activar el límite distribuido: Vercel dashboard → Marketplace → Upstash →
# crear una base Redis (tier gratis alcanza para este volumen) → copiar las
# dos variables de la integración. Ver src/lib/rate-limit.ts — no requiere
# cambios de código, solo configurar estas dos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
